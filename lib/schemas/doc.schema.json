{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "doc.json - narration plan for a recorded match (match mode)",
  "type": "object",
  "required": ["title", "segments"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "logline": { "type": "string" },
    "narrator": {
      "type": "object",
      "properties": { "voice": { "type": "string" }, "voice_desc": { "type": "string" }, "speed": { "type": "number" } }
    },
    "music": {
      "type": "object",
      "properties": { "mood_tags": { "type": "array", "items": { "type": "string" } }, "tempo": { "type": "string", "enum": ["slow", "mid", "fast"] }, "track_id": { "type": "string" }, "gain_db": { "type": "number" } }
    },
    "cards": { "type": "object" },
    "segments": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "from_sec", "to_sec", "focus"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "title": { "type": "string" },
          "finale": { "type": "boolean", "description": "The slow-motion last kill under the finale song. Exactly the segment digest.md gives under \"The finale\"; the program sets its speed and music." },
          "from_sec": { "type": "number", "minimum": 0 },
          "to_sec": { "type": "number", "minimum": 0 },
          "speed": { "type": "number", "minimum": 0.25, "maximum": 16, "description": "Playback speed; 1 = real time, 4 = timelapse" },
          "music": { "description": "Mood for this segment's music: \"sad\", [\"tense\",\"battle\"], or { mood_tags, tempo, track_id }. Omit to keep the film's default." },
          "focus": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Player names the camera follows; first is the lead" },
          "narration": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "at_sec", "text"],
              "properties": {
                "id": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
                "at_sec": { "type": "number", "minimum": 0, "description": "Seconds after the segment starts, in video time" },
                "text": { "type": "string", "minLength": 1 },
                "speaker": { "type": "string", "description": "Omit for the narrator. A player name makes it that player's voice: a real chat line (set chat true) or an invented in-character line." },
                "chat": { "type": "boolean", "description": "true when the text is a real chat line from the digest" },
                "emotion": { "type": "string" },
                "delivery": { "type": "string" }
              }
            }
          },
          "shots": {
            "description": "\"auto\" (default) or explicit shots with start_sec/end_sec relative to the segment",
            "oneOf": [
              { "type": "string", "enum": ["auto"] },
              { "type": "array", "items": { "type": "object", "required": ["id", "start_sec", "end_sec", "path"], "properties": { "id": { "type": "string" }, "start_sec": { "type": "number" }, "end_sec": { "type": "number" }, "fov": { "type": "number" }, "path": { "type": "object" } } } }
            ]
          }
        }
      }
    }
  }
}
