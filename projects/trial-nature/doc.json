      "music": "dark",
      "narration": [
        { "id": "n1", "at_sec": 0.5, "text": "Down on the ground, the wanderer has walked all night, and the night has noticed.", "emotion": "hushed" },
        { "id": "n2", "at_sec": 11.0, "text": "He is learning that the ground is no place to live.", "emotion": "thoughtful" }
      ],
