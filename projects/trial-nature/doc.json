        { "id": "n3", "at_sec": 14.5, "text": "Up here he can see for miles. And for miles, he can be seen.", "emotion": "thoughtful" },
        { "id": "p1", "at_sec": 22.9, "speaker": "WorkingStorage", "chat": true, "text": "high risk, high reward", "emotion": "calm" }
