      "music": "suspense",
      "narration": [
        { "id": "n1", "at_sec": 1.0, "text": "So he returns to the hill, and climbs toward the one who never came down.", "emotion": "building" },
        { "id": "n2", "at_sec": 8.0, "text": "Nine minutes he has waited up there.", "emotion": "tense" },
        { "id": "n3", "at_sec": 12.0, "text": "Down here, a life lost is lost for good.", "emotion": "tense" }
