        { "id": "n3", "at_sec": 35.0, "text": "And the answer is UP! A sixty-one block tower, straight into the clouds!", "emotion": "shouting" },
        { "id": "n4", "at_sec": 41.5, "text": "Build it, sit on top, and wait for anybody brave enough to walk underneath!", "emotion": "excited" },
